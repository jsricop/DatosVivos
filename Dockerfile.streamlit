# Dockerfile para la interfaz Streamlit (Capa 3, Sprint 4).
# La app envuelve el motor de IA (Capa 2) y consume el MCP server (Capa 1)
# vía SSE. Requiere requirements.mcp + requirements.ai + requirements.streamlit.
#
# Seguridad: corre como usuario no-root `appuser` (UID/GID configurables vía
# build-args, default 1000:1000). Esto evita problemas de permisos cuando
# se monta el volumen `./data` desde el host: el UID del container debe
# coincidir con el UID del propietario del directorio en el host.

FROM python:3.11-slim

ARG APP_UID=1000
ARG APP_GID=1000

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Crear usuario no-root con UID/GID parametrizable
RUN groupadd --system --gid ${APP_GID} appuser \
 && useradd --system --uid ${APP_UID} --gid ${APP_GID} \
        --shell /usr/sbin/nologin --create-home appuser

WORKDIR /app
RUN chown appuser:appuser /app

# Dependencias (las 3 capas — la UI integra todo el stack)
COPY --chown=appuser:appuser requirements.mcp.txt requirements.ai.txt requirements.streamlit.txt ./
RUN pip install -r requirements.mcp.txt \
 && pip install -r requirements.ai.txt \
 && pip install -r requirements.streamlit.txt

# Código fuente y config (con ownership correcto desde el inicio)
COPY --chown=appuser:appuser mcp_server/ ./mcp_server/
COPY --chown=appuser:appuser ai_engine/ ./ai_engine/
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser scripts/ ./scripts/
COPY --chown=appuser:appuser .streamlit/ ./.streamlit/

# Cambiar a usuario no-root para runtime
USER appuser

# Índice vectorial: se monta como volumen en producción (artefacto pre-built),
# o se construye on-demand vía `python -m scripts.build_index` desde dentro
# del container.

EXPOSE 8501

CMD ["streamlit", "run", "app/main.py", "--server.port=8501", "--server.address=0.0.0.0"]
