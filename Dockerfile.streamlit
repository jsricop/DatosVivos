# Dockerfile para la interfaz Streamlit (Capa 3, Sprint 4).
# La app envuelve el motor de IA (Capa 2) y consume el MCP server (Capa 1)
# vía SSE. Requiere requirements.mcp + requirements.ai + requirements.streamlit.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

# Dependencias (las 3 capas — la UI integra todo el stack)
COPY requirements.mcp.txt requirements.ai.txt requirements.streamlit.txt ./
RUN pip install -r requirements.mcp.txt \
 && pip install -r requirements.ai.txt \
 && pip install -r requirements.streamlit.txt

# Código fuente y config
COPY mcp_server/ ./mcp_server/
COPY ai_engine/ ./ai_engine/
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY .streamlit/ ./.streamlit/

# Índice vectorial: se monta como volumen en producción (artefacto pre-built),
# o se construye on-demand vía `python -m scripts.build_index` desde el
# container (con el directorio scripts/ copiado arriba). No se copia el
# índice aquí para mantener la imagen ligera.

EXPOSE 8501

CMD ["streamlit", "run", "app/main.py", "--server.port=8501", "--server.address=0.0.0.0"]
