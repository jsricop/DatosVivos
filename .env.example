# .env.example — copiar a .env y completar valores reales

# === VPN (FortiClient SSL) ===
VPN_HOST=                          # Gateway FortiClient (dominio .co)
VPN_PORT=                          # Puerto personalizado (ver FortiClient)
VPN_USER=                          # Usuario VPN ANI

# === SSH a la VM ===
VM_HOST=                           # IP interna de la VM (solo accesible tras VPN)
SSH_PORT=22                        # Puerto SSH (default 22, cambiar si es custom)
SSH_USER=                          # Usuario SSH en la VM
SSH_KEY_PATH=                      # Ruta a llave privada SSH (opcional, si no usa password)

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datosvivos
POSTGRES_USER=datosvivos
POSTGRES_PASSWORD=                 # Generar password seguro

# === Ollama ===
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=llama3:8b-instruct-q4_K_M

# === LLM Backend (intercambiable) ===
LLM_BACKEND=ollama                 # ollama | openai | anthropic
# OPENAI_API_KEY=                  # Solo si LLM_BACKEND=openai
# ANTHROPIC_API_KEY=               # Solo si LLM_BACKEND=anthropic

# === datos.gov.co ===
SOCRATA_DOMAIN=www.datos.gov.co
SOCRATA_APP_TOKEN=                 # Opcional: mayor rate limit
DISCOVERY_API_URL=https://api.us.socrata.com/api/catalog/v1

# === Streamlit ===
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark

# === MCP Server ===
MCP_TRANSPORT=sse                  # sse | stdio
MCP_PORT=3000

# === Aplicación ===
APP_ENV=development                # development | production
LOG_LEVEL=INFO
VECTOR_STORE=chromadb              # chromadb | faiss
INDEX_PATH=./data/vector_index
