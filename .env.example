# .env.example — copiar a .env y completar valores reales.
# Reglas:
#   - Sin comentarios inline a la derecha del valor (rompe parseo de pydantic-settings).
#   - Comentarios en líneas propias.
#   - Si una variable es opcional, déjala vacía (KEY=) o coméntala con #.

# === VPN (FortiClient SSL) ===
VPN_HOST=
VPN_PORT=
VPN_USER=

# === SSH a la VM ===
# IP interna de la VM (solo accesible tras VPN)
VM_HOST=
# Puerto SSH (default 22, cambiar si es custom)
SSH_PORT=22
SSH_USER=
# Ruta a llave privada SSH (opcional, si no usa password)
SSH_KEY_PATH=

# === PostgreSQL (ADR-014 — BD productiva para PowerBI) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datosvivos
POSTGRES_USER=dv
# Generar con `openssl rand -base64 32`
POSTGRES_PASSWORD=
# Connection string para Python (psycopg) y Next.js (next-auth adapter)
DATABASE_URL=postgresql://dv:CAMBIAR@postgres:5432/datosvivos

# === Ollama ===
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=llama3:8b-instruct-q4_K_M

# === LLM Backend (intercambiable: ollama | openai | anthropic) ===
LLM_BACKEND=ollama
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === datos.gov.co ===
SOCRATA_DOMAIN=www.datos.gov.co
# App token opcional — mayor rate limit. Registrar en https://datos.gov.co
SOCRATA_APP_TOKEN=
DISCOVERY_API_URL=https://api.us.socrata.com/api/catalog/v1

# === Streamlit ===
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark

# === MCP Server (sse | stdio) ===
MCP_TRANSPORT=sse
MCP_PORT=3000

# === Aplicación ===
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# chromadb | faiss
VECTOR_STORE=chromadb
INDEX_PATH=./data/vector_index

# === Frontend Next.js (web/) ===
NEXT_PUBLIC_SITE_URL=https://datosvivos.co
# Verificación opcional de Google Search Console (en metadata.verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Auth (NextAuth v5 — ADR-014) ===
# Generar con `openssl rand -base64 32`. Obligatorio en producción.
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://datosvivos.co
# SMTP institucional para magic-link. Ej: smtp://user:pass@smtp.gov.co:587
SMTP_URL=
# From address visible al usuario en el correo de magic-link.
SMTP_FROM="DatosVivos <accesos@datosvivos.co>"
# Lista blanca de dominios permitidos (separados por coma). Default permite cualquier `.gov.co`.
AUTH_ALLOWED_DOMAINS=

# === Power BI Embed (ADR-014) ===
# URL pública del dashboard publicado con publish-to-web. ANI genera esta URL
# desde Power BI Service → Archivo → Publicar en la web → Crear código de inserción.
# El frontend agrega el filtro por entidad como query string.
NEXT_PUBLIC_PBI_EMBED_URL=
