# .env.example — copiar a .env y completar valores reales.
# Reglas:
#   - Sin comentarios inline a la derecha del valor (rompe parseo de pydantic-settings).
#   - Comentarios en líneas propias.
#   - Si una variable es opcional, déjala vacía (KEY=) o coméntala con #.

# === VPN (FortiClient SSL) ===
VPN_HOST=
VPN_PORT=
VPN_USER=

# === SSH a la VM ===
# IP interna de la VM (solo accesible tras VPN)
VM_HOST=
# Puerto SSH (default 22, cambiar si es custom)
SSH_PORT=22
SSH_USER=
# Ruta a llave privada SSH (opcional, si no usa password)
SSH_KEY_PATH=

# === PostgreSQL (ADR-014 — BD productiva para PowerBI) ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=datosvivos
POSTGRES_USER=dv
# Generar con `openssl rand -base64 32`
POSTGRES_PASSWORD=
# Connection string para Python (psycopg) y Next.js (next-auth adapter)
DATABASE_URL=postgresql://dv:CAMBIAR@postgres:5432/datosvivos

# === Ollama (tiered models, ADR-015) ===
OLLAMA_HOST=http://ollama:11434
# Modelo rápido para tareas mecánicas (rerank, SoQL gen, dashboard spec).
OLLAMA_MODEL_FAST=qwen2.5-coder:3b
# Modelo medio para narrativa (mejor prosa es-CO).
OLLAMA_MODEL_NARRATIVE=qwen2.5:7b
# Legacy single-model. Si las tiered no están seteadas se usa este para todo.
# Útil para rollback de emergencia a un modelo único.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:14b

# === LLM Backend (intercambiable: anthropic | ollama | mock) ===
# PRODUCCIÓN corre con anthropic desde 2026-07-11 (Haiku: interpretación NL en
# ~1.5 s vs 31-45 s del modelo local). Para réplicas locales sin API key,
# LLM_BACKEND=ollama sigue soportado (requiere bajar los modelos qwen).
LLM_BACKEND=ollama

# === Anthropic API (backend de producción) ===
#   1. Setear LLM_BACKEND=anthropic
#   2. Setear ANTHROPIC_API_KEY (https://console.anthropic.com/settings/keys)
#   3. docker compose up -d --force-recreate api   (runtime, sin rebuild)
# Modelos default: haiku para todo. Override por task con _FAST/_NARRATIVE.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_NARRATIVE=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === datos.gov.co ===
SOCRATA_DOMAIN=www.datos.gov.co
# App token opcional — mayor rate limit. Registrar en https://datos.gov.co
SOCRATA_APP_TOKEN=
DISCOVERY_API_URL=https://api.us.socrata.com/api/catalog/v1

# === Streamlit ===
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark

# === MCP Server (sse | stdio) ===
MCP_TRANSPORT=sse
MCP_PORT=3000

# === Aplicación ===
# development | production
APP_ENV=development
LOG_LEVEL=INFO
# chromadb | faiss
VECTOR_STORE=chromadb
INDEX_PATH=./data/vector_index

# === Frontend Next.js (web/) ===
NEXT_PUBLIC_SITE_URL=https://datosvivos.co
# Verificación opcional de Google Search Console (en metadata.verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Power BI Embed (tablero público /tablero) ===
# URL de «Publicar en la web» del dashboard. ANI la genera desde Power BI
# Service → Archivo → Publicar en la web → Crear código de inserción. Debe ser
# la forma anónima `https://app.powerbi.com/view?r=…` (un embed seguro con
# `autoAuth=true&ctid=…` NO renderiza para visitantes públicos).
# Se lee en RUNTIME (server-side): cambiarla solo requiere reiniciar el
# contenedor web, sin rebuild. Vacía → /tablero muestra un placeholder.
PBI_EMBED_URL=
# Alto del iframe en px. Opcional; default 541.
PBI_EMBED_HEIGHT=541
